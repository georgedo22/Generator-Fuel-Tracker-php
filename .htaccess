# =============================================================
#  Root .htaccess
#  Use this when you cannot point the domain directly at /public.
#  It rewrites every request into the public/ directory so the
#  app/ and database/ folders stay outside the web root.
# =============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive folders.
    RewriteRule ^(app|database|storage)/ - [F,L]

    # Rewrite all requests into public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
ServerSignature Off